// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                    @id @default(cuid())
  name                    String                    @default("")
  email                   String                    @unique @default("")
  password                String
  role                    Role?                     @relation("User_role", fields: [roleId], references: [id])
  roleId                  String?                   @map("role")
  barberProfile           BarberProfile?            @relation("BarberProfile_owner")
  onboardingStatus        UserOnboardingStatusType? @default(not_started)
  passwordResetToken      String?
  passwordResetIssuedAt   DateTime?
  passwordResetRedeemedAt DateTime?
  from_OAuthToken_user    OAuthToken[]              @relation("OAuthToken_user")

  @@index([roleId])
}

model Role {
  id                    String  @id @default(cuid())
  name                  String  @default("")
  canSeeOtherPeople     Boolean @default(false)
  canEditOtherPeople    Boolean @default(false)
  canManagePeople       Boolean @default(false)
  canManageRoles        Boolean @default(false)
  canAccessDashboard    Boolean @default(false)
  canManageBusiness     Boolean @default(false)
  canManageClients      Boolean @default(false)
  canManageAppointments Boolean @default(false)
  canManagePayments     Boolean @default(false)
  canViewEarnings       Boolean @default(false)
  assignedTo            User[]  @relation("User_role")
}

model OAuthApp {
  id                      String   @id @default(cuid())
  name                    String   @default("")
  clientId                String   @unique @default("")
  clientSecret            String   @default("")
  tokenEndpointAuthMethod String?  @default("client_secret_post")
  redirectUris            Json?    @default("[]")
  scopes                  Json?    @default("[\"mcp:read\",\"mcp:write\"]")
  webhookUrl              String   @default("")
  status                  String?  @default("active")
  installUrl              String   @default("")
  uninstallUrl            String   @default("")
  description             String   @default("")
  metadata                Json?    @default("{}")
  developerEmail          String   @default("")
  privacyPolicyUrl        String   @default("")
  termsOfServiceUrl       String   @default("")
  supportUrl              String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
}

model OAuthToken {
  id                  String    @id @default(cuid())
  tokenType           String
  token               String    @unique @default("")
  clientId            String    @default("")
  user                User?     @relation("OAuthToken_user", fields: [userId], references: [id])
  userId              String?   @map("user")
  scopes              Json?     @default("[]")
  redirectUri         String    @default("")
  resource            String    @default("")
  expiresAt           DateTime?
  isRevoked           String?   @default("false")
  authorizationCode   String    @default("")
  refreshToken        String    @default("")
  accessToken         String    @default("")
  state               String    @default("")
  codeChallenge       String    @default("")
  codeChallengeMethod String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([clientId])
  @@index([userId])
}

model BarberProfile {
  id                      String                     @id @default(cuid())
  owner                   User?                      @relation("BarberProfile_owner", fields: [ownerId], references: [id])
  ownerId                 String?                    @unique @map("owner")
  businessName            String                     @default("")
  slug                    String                     @unique @default("")
  bio                     String                     @default("")
  photoPath               String                     @default("")
  phone                   String                     @default("")
  email                   String                     @default("")
  location                String                     @default("")
  timezone                String                     @default("America/New_York")
  currencyCode            String                     @default("USD")
  bookingOpen             Boolean                    @default(true)
  slotMinutes             Int                        @default(15)
  bufferMinutes           Int                        @default(10)
  minNoticeHours          Int                        @default(2)
  maxAdvanceDays          Int                        @default(60)
  cancellationWindowHours Int                        @default(24)
  noShowFeeCents          Int                        @default(0)
  workStyle               BarberProfileWorkStyleType @default(own_space)
  services                Service[]                  @relation("Service_profile")
  weeklyHours             WeeklyHours[]              @relation("WeeklyHours_profile")
  timeOff                 TimeOff[]                  @relation("TimeOff_profile")
  clients                 Client[]                   @relation("Client_profile")
  appointments            Appointment[]              @relation("Appointment_profile")
  clientNotes             ClientNote[]               @relation("ClientNote_profile")
  products                Product[]                  @relation("Product_profile")
  productSales            ProductSale[]              @relation("ProductSale_profile")
  payments                Payment[]                  @relation("Payment_profile")
  paymentProviders        PaymentProvider[]          @relation("PaymentProvider_profile")
  paymentSessions         PaymentSession[]           @relation("PaymentSession_profile")
  chairRentals            ChairRental[]              @relation("ChairRental_profile")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @default(now()) @updatedAt
}

model Service {
  id              String        @id @default(cuid())
  profile         BarberProfile @relation("Service_profile", fields: [profileId], references: [id])
  profileId       String        @map("profile")
  name            String        @default("")
  description     String        @default("")
  photoPath       String        @default("")
  priceCents      Int
  durationMinutes Int           @default(30)
  depositCents    Int           @default(0)
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  appointments    Appointment[] @relation("Appointment_service")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([profileId])
}

model WeeklyHours {
  id               String                   @id @default(cuid())
  profile          BarberProfile            @relation("WeeklyHours_profile", fields: [profileId], references: [id])
  profileId        String                   @map("profile")
  dayOfWeek        WeeklyHoursDayOfWeekType
  isWorking        Boolean                  @default(true)
  startMinute      Int                      @default(540)
  endMinute        Int                      @default(1020)
  breakStartMinute Int?
  breakEndMinute   Int?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt

  @@index([profileId])
}

model TimeOff {
  id        String        @id @default(cuid())
  profile   BarberProfile @relation("TimeOff_profile", fields: [profileId], references: [id])
  profileId String        @map("profile")
  startsAt  DateTime
  endsAt    DateTime
  reason    String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  @@index([profileId])
}

model Client {
  id           String           @id @default(cuid())
  profile      BarberProfile    @relation("Client_profile", fields: [profileId], references: [id])
  profileId    String           @map("profile")
  firstName    String           @default("")
  lastName     String           @default("")
  phone        String           @default("")
  email        String           @default("")
  status       ClientStatusType @default(active)
  preferences  String           @default("")
  lastVisitAt  DateTime?
  notes        ClientNote[]     @relation("ClientNote_client")
  appointments Appointment[]    @relation("Appointment_client")
  productSales ProductSale[]    @relation("ProductSale_client")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@index([profileId])
}

model ClientNote {
  id            String        @id @default(cuid())
  profile       BarberProfile @relation("ClientNote_profile", fields: [profileId], references: [id])
  profileId     String        @map("profile")
  client        Client?       @relation("ClientNote_client", fields: [clientId], references: [id])
  clientId      String?       @map("client")
  appointment   Appointment?  @relation("ClientNote_appointment", fields: [appointmentId], references: [id])
  appointmentId String?       @map("appointment")
  body          String        @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@index([profileId])
  @@index([clientId])
  @@index([appointmentId])
}

model Appointment {
  id                    String                       @id @default(cuid())
  profile               BarberProfile                @relation("Appointment_profile", fields: [profileId], references: [id])
  profileId             String                       @map("profile")
  client                Client?                      @relation("Appointment_client", fields: [clientId], references: [id])
  clientId              String?                      @map("client")
  service               Service?                     @relation("Appointment_service", fields: [serviceId], references: [id])
  serviceId             String?                      @map("service")
  startsAt              DateTime
  endsAt                DateTime?
  serviceNameSnapshot   String                       @default("")
  priceCents            Int                          @default(0)
  depositCents          Int                          @default(0)
  status                AppointmentStatusType        @default(confirmed)
  source                AppointmentSourceType        @default(phone)
  paymentStatus         AppointmentPaymentStatusType @default(unpaid)
  clientNotes           String                       @default("")
  internalNotes         String                       @default("")
  cancellationReason    String                       @default("")
  publicAccessTokenHash String                       @default("")
  notes                 ClientNote[]                 @relation("ClientNote_appointment")
  productSales          ProductSale[]                @relation("ProductSale_appointment")
  payments              Payment[]                    @relation("Payment_appointment")
  paymentSessions       PaymentSession[]             @relation("PaymentSession_appointment")
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @default(now()) @updatedAt

  @@index([profileId])
  @@index([clientId])
  @@index([serviceId])
}

model Product {
  id         String        @id @default(cuid())
  profile    BarberProfile @relation("Product_profile", fields: [profileId], references: [id])
  profileId  String        @map("profile")
  name       String        @default("")
  priceCents Int
  stock      Int           @default(0)
  active     Boolean       @default(true)
  sales      ProductSale[] @relation("ProductSale_product")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt

  @@index([profileId])
}

model ProductSale {
  id                  String        @id @default(cuid())
  profile             BarberProfile @relation("ProductSale_profile", fields: [profileId], references: [id])
  profileId           String        @map("profile")
  product             Product?      @relation("ProductSale_product", fields: [productId], references: [id])
  productId           String?       @map("product")
  client              Client?       @relation("ProductSale_client", fields: [clientId], references: [id])
  clientId            String?       @map("client")
  appointment         Appointment?  @relation("ProductSale_appointment", fields: [appointmentId], references: [id])
  appointmentId       String?       @map("appointment")
  productNameSnapshot String        @default("")
  quantity            Int           @default(1)
  unitPriceCents      Int
  totalCents          Int
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  @@index([profileId])
  @@index([productId])
  @@index([clientId])
  @@index([appointmentId])
}

model Payment {
  id                String            @id @default(cuid())
  profile           BarberProfile?    @relation("Payment_profile", fields: [profileId], references: [id])
  profileId         String?           @map("profile")
  appointment       Appointment?      @relation("Payment_appointment", fields: [appointmentId], references: [id])
  appointmentId     String?           @map("appointment")
  method            PaymentMethodType @default(cash)
  kind              PaymentKindType   @default(service)
  status            PaymentStatusType @default(paid)
  amountCents       Int
  tipCents          Int               @default(0)
  productsCents     Int               @default(0)
  providerReference String            @default("")
  paidAt            DateTime?         @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@index([profileId])
  @@index([appointmentId])
}

model PaymentProvider {
  id                          String           @id @default(cuid())
  profile                     BarberProfile    @relation("PaymentProvider_profile", fields: [profileId], references: [id])
  profileId                   String           @map("profile")
  name                        String           @default("")
  code                        String           @default("")
  isInstalled                 Boolean          @default(true)
  createPaymentFunction       String           @default("manual")
  capturePaymentFunction      String           @default("manual")
  refundPaymentFunction       String           @default("manual")
  getPaymentStatusFunction    String           @default("manual")
  generatePaymentLinkFunction String           @default("manual")
  handleWebhookFunction       String           @default("manual")
  paymentSessions             PaymentSession[] @relation("PaymentSession_paymentProvider")
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @default(now()) @updatedAt

  @@index([profileId])
}

model PaymentSession {
  id                String                   @id @default(cuid())
  profile           BarberProfile?           @relation("PaymentSession_profile", fields: [profileId], references: [id])
  profileId         String?                  @map("profile")
  appointment       Appointment?             @relation("PaymentSession_appointment", fields: [appointmentId], references: [id])
  appointmentId     String?                  @map("appointment")
  paymentProvider   PaymentProvider?         @relation("PaymentSession_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId String?                  @map("paymentProvider")
  status            PaymentSessionStatusType @default(pending)
  amountCents       Int
  currencyCode      String                   @default("USD")
  providerPaymentId String                   @default("")
  expiresAt         DateTime?
  capturedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt

  @@index([profileId])
  @@index([appointmentId])
  @@index([paymentProviderId])
}

model ChairRental {
  id          String                @id @default(cuid())
  profile     BarberProfile         @relation("ChairRental_profile", fields: [profileId], references: [id])
  profileId   String                @map("profile")
  hostName    String                @default("")
  hostContact String                @default("")
  rentCents   Int
  period      ChairRentalPeriodType @default(weekly)
  startsOn    DateTime?
  endsOn      DateTime?
  status      ChairRentalStatusType @default(active)
  terms       String                @default("")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt

  @@index([profileId])
}

enum UserOnboardingStatusType {
  not_started
  done
  dismissed
}

enum BarberProfileWorkStyleType {
  own_space
  chair_rental
  mobile
}

enum WeeklyHoursDayOfWeekType {
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

enum ClientStatusType {
  active
  vip
  blocked
}

enum AppointmentStatusType {
  requested
  confirmed
  completed
  cancelled
  no_show
}

enum AppointmentSourceType {
  online
  phone
  walk_in
}

enum AppointmentPaymentStatusType {
  unpaid
  deposit_paid
  paid
  refunded
}

enum PaymentMethodType {
  cash
  card
  transfer
  stripe
}

enum PaymentKindType {
  deposit
  service
  refund
  no_show_fee
}

enum PaymentStatusType {
  paid
  refunded
}

enum PaymentSessionStatusType {
  pending
  captured
  expired
  cancelled
  refunded
}

enum ChairRentalPeriodType {
  weekly
  monthly
}

enum ChairRentalStatusType {
  active
  ended
}
